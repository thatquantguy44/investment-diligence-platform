# Copy to deploy/dagster/.env in the deployment environment. This file is
# ignored by Git. Prefer your platform's secret manager when one is available.

# Pipeline data storage; use either a complete DSN or the component variables.
DILIGENCE_POSTGRES_DSN=
DILIGENCE_POSTGRES_HOST=
DILIGENCE_POSTGRES_PORT=55432
DILIGENCE_POSTGRES_DB=IDP
DILIGENCE_POSTGRES_USER=
DILIGENCE_POSTGRES_PASSWORD=

# Required for live USPTO ODP discovery and approved-refresh downloads.
USPTO_API_KEY=

# Reserved for future blocked/failed refresh notifications. The current
# deployment does not send webhooks or invoke this value.
DILIGENCE_ALERT_SLACK_WEBHOOK_URL=

# Keep the operator-controlled paths and freshness policy explicit at runtime.
USPTO_ODP_REVIEWED_SELECTION=/var/lib/diligence/uspto/reviewed_selection.json
USPTO_ODP_REFRESH_OUTPUT=/var/lib/diligence/uspto/g_patent.tsv.zip
USPTO_ODP_PREVIOUS_FILE=
USPTO_ODP_REFRESH_MAX_AGE_DAYS=45
