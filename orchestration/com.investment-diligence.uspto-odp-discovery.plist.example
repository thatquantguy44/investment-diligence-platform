<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.investment-diligence.uspto-odp-discovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>cd /absolute/path/to/investment-diligence-platform &amp;&amp; ./scripts/uspto_odp_discovery.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>StandardOutPath</key>
  <string>/absolute/path/to/investment-diligence-platform/.data/uspto/discovery.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/investment-diligence-platform/.data/uspto/discovery.err.log</string>
</dict>
</plist>
