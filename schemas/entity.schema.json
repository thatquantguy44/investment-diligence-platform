{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/diligence/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": ["record_id", "schema_version", "pipeline_id", "source_id", "run_id", "created_at", "entity_id", "entity_type", "canonical_name", "identifiers", "evidence_refs"],
  "properties": {
    "record_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "pipeline_id": {"type": "string"},
    "source_id": {"type": "string"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "entity_id": {"type": "string"},
    "entity_type": {"type": "string"},
    "canonical_name": {"type": "string"},
    "jurisdiction": {"type": ["string", "null"]},
    "identifiers": {"type": "array", "items": {"type": "object"}},
    "first_seen_at": {"type": ["string", "null"], "format": "date-time"},
    "entity_status": {"enum": ["active", "inactive", "unknown"]},
    "evidence_refs": {"type": "array", "items": {"$ref": "evidence.schema.json"}}
  },
  "additionalProperties": false
}
